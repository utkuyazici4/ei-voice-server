# Turn the optional similar-voices layer on or off
USE_SIMILAR_VOICES=false

# Only needed when USE_SIMILAR_VOICES=true
ELEVENLABS_API_KEY=

# pitch (default, fast) or speechbrain (needs wiring up)
CLASSIFIER_BACKEND=pitch

# Milliseconds of caller audio before we classify
MIN_SPEECH_MS=4000
MAX_SPEECH_MS=15000

# Below this the call goes to fallback instead of guessing
MIN_CONFIDENCE=0.60

# Seconds to keep a call result in memory
RESULT_TTL_SECS=1800

LOG_LEVEL=INFO
